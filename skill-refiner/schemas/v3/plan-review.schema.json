{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approved",
    "issues",
    "case_contracts"
  ],
  "properties": {
    "approved": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "case_contracts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "installed_source_unchanged",
          "fixture_contract_consistent",
          "response_contract_consistent",
          "trace_checks_observable",
          "scenario_consistent",
          "requirement_trace_consistent",
          "expected_outcome_consistent",
          "machine_checks_consistent",
          "matrix_complete",
          "asset_audit_consistent",
          "positive_controls_validated",
          "negative_controls_targeted",
          "basis",
          "acceptance_criteria_traceable",
          "scenario_detail_complete",
          "risk_coverage_complete"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "installed_source_unchanged": {
            "type": "boolean"
          },
          "fixture_contract_consistent": {
            "type": "boolean"
          },
          "response_contract_consistent": {
            "type": "boolean"
          },
          "trace_checks_observable": {
            "type": "boolean"
          },
          "scenario_consistent": {
            "type": "boolean"
          },
          "requirement_trace_consistent": {
            "type": "boolean"
          },
          "expected_outcome_consistent": {
            "type": "boolean"
          },
          "machine_checks_consistent": {
            "type": "boolean"
          },
          "matrix_complete": {
            "type": "boolean"
          },
          "asset_audit_consistent": {
            "type": "boolean"
          },
          "positive_controls_validated": {
            "type": "boolean"
          },
          "negative_controls_targeted": {
            "type": "boolean"
          },
          "basis": {
            "type": "string",
            "minLength": 12
          },
          "acceptance_criteria_traceable": {
            "type": "boolean"
          },
          "scenario_detail_complete": {
            "type": "boolean"
          },
          "risk_coverage_complete": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approved": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "issues": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.plan-review-v3",
  "x-schema-version": "v3"
}
