{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.unified-diff",
  "type": "string",
  "anyOf": [
    {
      "const": ""
    },
    {
      "pattern": "^(?:diff --git .+|--- .+)(?:\\r?\\n|$)"
    }
  ],
  "contentEncoding": "utf-8",
  "contentMediaType": "text/x-diff",
  "x-schema-version": "v1"
}
