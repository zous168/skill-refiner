{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-skill.self-review-record",
  "x-schema-version": "v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage_id",
    "overall_result",
    "review_round",
    "checks",
    "open_gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-skill.self-review-record/v1"
    },
    "stage_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "overall_result": {
      "enum": ["pass", "revise_once", "blocked"]
    },
    "review_round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "requirement_ids",
          "acceptance_criterion_ids",
          "scenario_ids",
          "result",
          "evidence_refs"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "acceptance_criterion_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "scenario_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "result": {
            "enum": ["pass", "fail", "not_applicable", "blocked"]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "gap": {"type": "string", "minLength": 8},
          "scope_reason": {"type": "string", "minLength": 8}
        },
        "allOf": [
          {
            "if": {"properties": {"result": {"const": "pass"}}},
            "then": {"properties": {"evidence_refs": {"minItems": 1}}}
          },
          {
            "if": {"properties": {"result": {"const": "not_applicable"}}},
            "then": {"required": ["scope_reason"]}
          },
          {
            "if": {"properties": {"result": {"enum": ["fail", "blocked"]}}},
            "then": {"required": ["gap"]}
          }
        ]
      }
    },
    "open_gaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "description"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 8}
        }
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 8
    }
  },
  "allOf": [
    {
      "if": {"properties": {"overall_result": {"const": "pass"}}},
      "then": {
        "properties": {
          "checks": {"items": {"properties": {"result": {"enum": ["pass", "not_applicable"]}}}},
          "open_gaps": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"overall_result": {"const": "revise_once"}}},
      "then": {
        "required": ["next_action"],
        "properties": {
          "review_round": {"const": 0},
          "checks": {"contains": {"properties": {"result": {"const": "fail"}}}},
          "open_gaps": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"overall_result": {"const": "blocked"}}},
      "then": {
        "required": ["next_action"],
        "properties": {"open_gaps": {"minItems": 1}}
      }
    }
  ]
}
