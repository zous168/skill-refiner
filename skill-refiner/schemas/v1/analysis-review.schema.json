{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approved",
    "issues",
    "requirement_assessments",
    "scenario_assessments"
  ],
  "properties": {
    "approved": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "grounded",
          "acceptance_criteria_atomic",
          "criteria_observable",
          "basis"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "grounded": {
            "type": "boolean"
          },
          "acceptance_criteria_atomic": {
            "type": "boolean"
          },
          "criteria_observable": {
            "type": "boolean"
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scenario_assessments": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "detail_executable",
          "risk_coverage_complete",
          "traceability_complete",
          "basis"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "detail_executable": {
            "type": "boolean"
          },
          "risk_coverage_complete": {
            "type": "boolean"
          },
          "traceability_complete": {
            "type": "boolean"
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approved": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "issues": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.analysis-review",
  "x-schema-version": "v1"
}
