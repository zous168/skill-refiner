{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.stage-artifact-contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "media_type",
    "glob",
    "required",
    "contract_id",
    "schema_ref"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "media_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "glob": {
      "type": "boolean"
    },
    "required": {
      "type": "boolean"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "content_policy": {
      "enum": [
        "fixed",
        "by_media_type"
      ]
    },
    "schema_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "validator_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^schemas/[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validator_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "x-schema-version": "v1"
}
