{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schemas",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-refiner.skill-stage-contracts/v1"
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "description": "Declare one active version per stable logical schema ID. Keep historical compatibility formats inside the authoring controller, not in a delivered target Skill contract.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "path",
          "validator_id",
          "validator_path",
          "runtime_needed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^v[0-9]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^schemas/v[0-9]+/[A-Za-z0-9._/-]+\\.schema\\.json$",
            "description": "The vN directory must match the declared schema version."
          },
          "validator_id": {
            "type": "string",
            "minLength": 1
          },
          "validator_path": {
            "type": "string",
            "minLength": 1
          },
          "runtime_needed": {
            "type": "boolean"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "goal",
          "requirement_ids",
          "inputs",
          "outputs",
          "validation_gate",
          "validation_points",
          "failure_states",
          "completion_check",
          "resume_policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "goal": {
            "type": "string",
            "minLength": 8
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/stage_artifact"
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/stage_artifact"
            }
          },
          "validation_gate": {
            "type": "string",
            "minLength": 8
          },
          "validation_points": {
            "type": "array",
            "minItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "after_generation",
                "before_handoff",
                "on_resume",
                "final_verification"
              ]
            }
          },
          "failure_states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "completion_check": {
            "type": "string",
            "minLength": 8
          },
          "resume_policy": {
            "enum": [
              "reuse_if_contract_hashes_match",
              "retry_incomplete",
              "restart_stage"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "stage_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "media_type",
        "schema_id",
        "schema_version",
        "required"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.skill-stage-contracts",
  "x-schema-version": "v1"
}
