{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "goal",
    "requirements",
    "workflow",
    "scenarios",
    "assumptions",
    "external_dependencies",
    "blocking_questions"
  ],
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "behavior",
          "source",
          "required",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "behavior": {
            "type": "string",
            "minLength": 8
          },
          "source": {
            "type": "string",
            "minLength": 3
          },
          "required": {
            "type": "boolean"
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "statement",
                "evidence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "statement": {
                  "type": "string",
                  "minLength": 8
                },
                "evidence": {
                  "type": "string",
                  "minLength": 8
                }
              }
            }
          }
        }
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "inputs",
          "outputs",
          "completion_check",
          "failure_behavior",
          "requirement_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "string",
            "minLength": 1
          },
          "outputs": {
            "type": "string",
            "minLength": 1
          },
          "completion_check": {
            "type": "string",
            "minLength": 8
          },
          "failure_behavior": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "applicable",
          "situation",
          "requirement_ids",
          "acceptance_criteria_ids",
          "detail",
          "basis",
          "exclusion_reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "kind": {
            "enum": [
              "normal",
              "boundary",
              "error",
              "negative",
              "regression"
            ]
          },
          "applicable": {
            "type": "boolean"
          },
          "situation": {
            "type": "string",
            "minLength": 8
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "preconditions",
              "stimulus",
              "actions",
              "expected_observables",
              "forbidden_outcomes",
              "risk_dimensions",
              "basis"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 8
              },
              "preconditions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "stimulus": {
                "type": "string",
                "minLength": 8
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "expected_observables": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              },
              "forbidden_outcomes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              },
              "risk_dimensions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "input_variation",
                    "workflow_state",
                    "role_permission",
                    "dependency_failure",
                    "cross_requirement",
                    "side_effect",
                    "retry_recovery",
                    "idempotency",
                    "ambiguity_conflict",
                    "asset_handling",
                    "safety_boundary",
                    "other"
                  ]
                }
              },
              "basis": {
                "type": "string",
                "minLength": 12
              }
            }
          },
          "basis": {
            "type": "string",
            "minLength": 12
          },
          "exclusion_reason": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "applicable": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "exclusion_reason": {
                  "type": "string",
                  "minLength": 12
                }
              }
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.analysis",
  "x-schema-version": "v1"
}
