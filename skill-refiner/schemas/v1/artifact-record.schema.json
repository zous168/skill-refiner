{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.artifact-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "media_type",
    "bytes",
    "sha256",
    "schema_ref",
    "validation"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "validator_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^schemas/[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validator_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validator_id"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed"
          ]
        },
        "validator_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "x-schema-version": "v1"
}
