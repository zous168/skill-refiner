{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.binary-content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bytes",
    "sha256"
  ],
  "properties": {
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "x-schema-version": "v1"
}
