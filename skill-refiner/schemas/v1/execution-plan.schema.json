{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective",
    "scope",
    "max_parallel_agents",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-refiner.execution-plan/v1"
    },
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope",
        "constraints"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "out_of_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "max_parallel_agents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "title",
          "goal",
          "actions",
          "inputs",
          "outputs",
          "requirement_ids",
          "case_ids",
          "depends_on",
          "execution_mode",
          "parallel_wave",
          "serial_reason",
          "agent",
          "exit_criteria",
          "failure_policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "goal": {
            "type": "string",
            "minLength": 8
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "schema_id",
                "schema_version",
                "evidence"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "schema_id": {
                  "type": "string",
                  "minLength": 1
                },
                "schema_version": {
                  "type": "string",
                  "pattern": "^v[0-9]+$"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "case_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "execution_mode": {
            "enum": [
              "serial",
              "parallel"
            ]
          },
          "parallel_wave": {
            "type": [
              "string",
              "null"
            ]
          },
          "serial_reason": {
            "type": "string"
          },
          "agent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "scope",
              "write_scope",
              "merge_owner",
              "join_gate"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 3
              },
              "scope": {
                "type": "string",
                "minLength": 8
              },
              "write_scope": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "merge_owner": {
                "type": "string",
                "minLength": 2
              },
              "join_gate": {
                "type": "string",
                "minLength": 8
              }
            }
          },
          "exit_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "condition",
                "evidence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "condition": {
                  "type": "string",
                  "minLength": 8
                },
                "evidence": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          },
          "failure_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "max_attempts",
              "terminal_state",
              "recovery_policy"
            ],
            "properties": {
              "action": {
                "enum": [
                  "stop",
                  "bounded_retry",
                  "replan",
                  "block"
                ]
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "terminal_state": {
                "enum": [
                  "blocked",
                  "error",
                  "not_passed"
                ]
              },
              "recovery_policy": {
                "enum": [
                  "reuse_verified",
                  "rerun_incomplete",
                  "restart_step",
                  "blocked"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "execution_mode": {
                  "const": "serial"
                }
              }
            },
            "then": {
              "required": [
                "serial_reason"
              ],
              "properties": {
                "serial_reason": {
                  "minLength": 8
                },
                "parallel_wave": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "execution_mode": {
                  "const": "parallel"
                }
              }
            },
            "then": {
              "required": [
                "parallel_wave"
              ],
              "properties": {
                "parallel_wave": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "failure_policy": {
                  "properties": {
                    "action": {
                      "const": "stop"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "failure_policy": {
                  "properties": {
                    "max_attempts": {
                      "const": 0
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "failure_policy": {
                  "properties": {
                    "action": {
                      "enum": [
                        "bounded_retry",
                        "replan"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "failure_policy": {
                  "properties": {
                    "max_attempts": {
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.execution-plan",
  "x-schema-version": "v1"
}
