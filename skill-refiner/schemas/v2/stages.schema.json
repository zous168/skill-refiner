{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.stages",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "status",
    "active_stage",
    "created_at",
    "updated_at",
    "schema_refs",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-refiner.stages/v2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "refine",
        "create"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "active_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "schema_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "path",
          "sha256",
          "validator_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^v[0-9]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^schemas/[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "validator_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interrupted_stage": {
      "type": "string"
    },
    "resume_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_resumed_at": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inputs",
          "outputs",
          "validation_gate",
          "failure_states",
          "status",
          "started_at",
          "completed_at",
          "artifacts",
          "input_artifacts",
          "missing_outputs",
          "missing_inputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "skill-refiner.stage-artifact-contract/v1",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "media_type",
                "glob",
                "required",
                "contract_id",
                "schema_ref"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "media_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "glob": {
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean"
                },
                "contract_id": {
                  "type": "string",
                  "minLength": 1
                },
                "content_policy": {
                  "enum": [
                    "fixed",
                    "by_media_type"
                  ]
                },
                "schema_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "version",
                    "path",
                    "sha256",
                    "validator_id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "pattern": "^v[0-9]+$"
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^schemas/[A-Za-z0-9._/-]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "validator_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "skill-refiner.stage-artifact-contract/v1",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "media_type",
                "glob",
                "required",
                "contract_id",
                "schema_ref"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "media_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "glob": {
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean"
                },
                "contract_id": {
                  "type": "string",
                  "minLength": 1
                },
                "content_policy": {
                  "enum": [
                    "fixed",
                    "by_media_type"
                  ]
                },
                "schema_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "version",
                    "path",
                    "sha256",
                    "validator_id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "pattern": "^v[0-9]+$"
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^schemas/[A-Za-z0-9._/-]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "validator_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "validation_gate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "implementation"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "implementation": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "failure_states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "completed",
              "blocked",
              "skipped"
            ]
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifacts": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "skill-refiner.artifact-record/v1",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "media_type",
                "bytes",
                "sha256",
                "schema_ref",
                "validation"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "media_type": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "schema_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "version",
                    "path",
                    "sha256",
                    "validator_id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "pattern": "^v[0-9]+$"
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^schemas/[A-Za-z0-9._/-]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "validator_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "validation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "validator_id"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "pending",
                        "passed"
                      ]
                    },
                    "validator_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "input_artifacts": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "skill-refiner.artifact-record/v1",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "media_type",
                "bytes",
                "sha256",
                "schema_ref",
                "validation"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "media_type": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "schema_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "version",
                    "path",
                    "sha256",
                    "validator_id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "pattern": "^v[0-9]+$"
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^schemas/[A-Za-z0-9._/-]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "validator_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "validation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "validator_id"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "pending",
                        "passed"
                      ]
                    },
                    "validator_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "missing_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interrupted": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "properties": {
                "artifacts": {
                  "items": {
                    "properties": {
                      "validation": {
                        "properties": {
                          "status": {
                            "const": "passed"
                          }
                        }
                      }
                    }
                  }
                },
                "input_artifacts": {
                  "items": {
                    "properties": {
                      "validation": {
                        "properties": {
                          "status": {
                            "const": "passed"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "x-schema-version": "v2"
}
